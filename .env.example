# --- Mizito credentials (fill ONE of the two options) ---
# Option A: token copied from the browser (DevTools > Application > Local Storage > office.mizito.ir > "token")
MIZITO_TOKEN=
# Option B: username/password; the server logs in and renews the token itself (not with two-step login)
MIZITO_USERNAME=
MIZITO_PASSWORD=
# Two-step login: an SMS code works only once, so use a token (option A) instead
MIZITO_LOGIN_CODE=

# Enable tools that change data (messages, letters, tasks, calendar, notes, projects, groups, files...). Off by default.
MIZITO_ENABLE_WRITE=0
# CRM tools (customers, deals, payments, call logs); only for workspaces whose plan includes CRM. Off by default.
MIZITO_ENABLE_CRM=0
# Workspace-admin tools (roles, permissions, settings, access repair, hand-over); only if you are a workspace admin.
MIZITO_ENABLE_ADMIN=0

# --- Transport ---
# stdio for Claude Desktop / Claude Code; streamable-http for Claude.ai / ChatGPT connectors
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# For a public server use a long random path, e.g. /mcp-3f9c...; it acts as the connector's secret
MCP_HTTP_PATH=/mcp
# Public hostname behind the reverse proxy (allowed in the Host header), e.g. mcp.example.com
MCP_PUBLIC_HOST=
